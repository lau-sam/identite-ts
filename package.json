{
  "name": "identite-ts",
  "version": "0.4.0",
  "description": "Client-side extraction of structured data from identity documents, in the browser: ICAO 9303 MRZ (TD1/TD2/TD3) for any issuing state, plus French 2D-DOC and NIR.",
  "keywords": [
    "mrz",
    "icao-9303",
    "passport",
    "id-card",
    "residence-permit",
    "td1",
    "td2",
    "td3",
    "2d-doc",
    "nir",
    "cni",
    "carte-vitale",
    "identite",
    "france",
    "ocr",
    "browser",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Coderkaine",
    "url": "https://www.coderkaine.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lau-sam/identite-ts.git"
  },
  "homepage": "https://github.com/lau-sam/identite-ts#readme",
  "bugs": {
    "url": "https://github.com/lau-sam/identite-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./insee": {
      "import": {
        "types": "./dist/insee/index.d.ts",
        "default": "./dist/insee/index.js"
      },
      "require": {
        "types": "./dist/insee/index.d.cts",
        "default": "./dist/insee/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "insee": [
        "./dist/insee/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^26.1.1",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  },
  "dependencies": {
    "tesseract.js": "^7.0.0",
    "zxing-wasm": "^3.1.1"
  }
}
