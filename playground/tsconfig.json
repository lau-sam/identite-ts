{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "identite-ts": ["../src/index.ts"],
      "identite-ts/insee": ["../src/insee/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
